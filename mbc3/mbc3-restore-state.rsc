# mbc3-restore-state
# revision: mbc3-final-20260601-bundle-aligned
# Purpose:
#   Restore MobileBandChange3 persisted globals from /file mbc3-state.txt.
#
# Contract:
#   - mbc3-state.txt is generated by MobileBandChange3 (inline file-based save).
#   - Restore refuses to run state if required markers are missing or any line
#     fails the allow-list check.
#   - mbc3RestoreDone is set true in every exit path.
#   - mbc3LogInited is intentionally not restored; first post-reboot run emits
#     a clean LTE init.

:global mbc3RestoreDone

:local tag "[mbc3-restore-state] "
:local stateFile "mbc3-state.txt"
:local markerStart "# MBC3-STATE-V1"
:local markerEnd "# MBC3-STATE-END"
:local minLen 80
:local maxLen 60000

# Allow-list guard. The state file is executed via [:parse], so before running
# it we verify every line is a comment or a :global/:set of a KNOWN state
# variable whose value is a single well-formed literal (a bare scalar, or one
# quoted string whose only unescaped quote is the final character). Any other
# line — e.g. a command appended after the markers — fails the check and we
# cold-start instead of executing untrusted file content.
:local stateReason do={
    :local data $1
    :local charset "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ._-"
    :local allow {
        "mbc3Debug"=1; "mbc3DebugRaw"=1; "mbc3HeartbeatEvery"=1;
        "mbc3QualityMonitor"=1; "mbc3LastPrimary"=1; "mbc3LastCA"=1;
        "mbc3LastCARaw"=1; "mbc3LastLRsrp"=1; "mbc3LastLSinr"=1;
        "mbc3LastNrActive"=1; "mbc3PendingLRsrp"=1; "mbc3PendingLRsrpCount"=1;
        "mbc3PendingLSinr"=1; "mbc3PendingLSinrCount"=1 }
    :local rest $data
    :local lineNo 0
    :while ([:len $rest] > 0) do={
        # Split on LF. Use [:typeof]="num" rather than comparing to the bare
        # identifier "nil" (which is unreliable in RouterOS).
        :local nl [:find $rest "\n"]
        :local line $rest
        :if ([:typeof $nl] = "num") do={
            :set line [:pick $rest 0 $nl]
            :set rest [:pick $rest ($nl + 1) [:len $rest]]
        } else={ :set rest "" }
        # Strip a single trailing CR (CRLF files), then reject any line with an
        # embedded CR — RouterOS [:parse] can treat a bare \r as a statement
        # separator, so "# marker\r/system reboot" must not slip through.
        :local ll [:len $line]
        :if (($ll > 0) and ([:pick $line ($ll - 1) $ll] = "\r")) do={ :set line [:pick $line 0 ($ll - 1)] }
        :set lineNo ($lineNo + 1)
        :if ([:typeof [:find $line "\r"]] = "num") do={ :return ("L" . $lineNo . ":embedded-cr") }
        # Trim leading spaces/tabs so an indented comment or a whitespace-only
        # line is classified correctly instead of cold-starting the restore.
        :while (([:len $line] > 0) and (([:pick $line 0 1] = " ") or ([:pick $line 0 1] = "\t"))) do={ :set line [:pick $line 1 [:len $line]] }
        :if (([:len $line] > 0) and ([:pick $line 0 1] != "#")) do={
            # Match the keyword without a trailing space: RouterOS trims trailing
            # whitespace from string literals, so a ":global "/":set " compare
            # never matched. Read the name from the allowed charset rather than
            # assuming a single space. Bare bools are saved as ":set mbc3Debug "
            # with NO value, so an empty value is allowed.
            :local kw ""
            :local idx 0
            :if ([:pick $line 0 7] = ":global") do={ :set kw "g"; :set idx 7 }
            :if (($kw = "") and ([:pick $line 0 4] = ":set")) do={ :set kw "s"; :set idx 4 }
            :if ($kw = "") do={ :return ("L" . $lineNo . ":not-assign") }
            # [:find] returns a num index when found and FALSE (not nil, not
            # "nothing") when not found, so test only the positive "num" case.
            :while (($idx < [:len $line]) and ([:typeof [:find $charset [:pick $line $idx ($idx + 1)]]] != "num")) do={ :set idx ($idx + 1) }
            :local name ""
            :while (($idx < [:len $line]) and ([:typeof [:find $charset [:pick $line $idx ($idx + 1)]]] = "num")) do={
                :set name ($name . [:pick $line $idx ($idx + 1)])
                :set idx ($idx + 1)
            }
            :if ([:typeof ($allow->$name)] = "nothing") do={ :return ("L" . $lineNo . ":unknown-var:" . $name) }
            :local val ""
            :if ($idx < [:len $line]) do={ :set val [:pick $line ($idx + 1) [:len $line]] }
            :if (($kw = "g") and ([:len $val] > 0)) do={ :return ("L" . $lineNo . ":global-has-value") }
            :if (($kw = "s") and ([:len $val] > 0)) do={
                :if ([:pick $val 0 1] = "\"") do={
                    :local vl [:len $val]
                    :local i 1
                    :local esc false
                    :local closedAt -1
                    :while (($i < $vl) and ($closedAt < 0)) do={
                        :local c [:pick $val $i ($i + 1)]
                        :if ($esc = true) do={ :set esc false } else={
                            :if ($c = "\\") do={ :set esc true } else={
                                :if ($c = "\$") do={ :return ("L" . $lineNo . ":bad-dollar") }
                                :if ($c = "\"") do={ :set closedAt $i }
                            }
                        }
                        :set i ($i + 1)
                    }
                    :if ($closedAt != ($vl - 1)) do={ :return ("L" . $lineNo . ":bad-quoted") }
                } else={
                    :local j 0
                    :while ($j < [:len $val]) do={
                        :if ([:typeof [:find $charset [:pick $val $j ($j + 1)]]] != "num") do={ :return ("L" . $lineNo . ":bad-char:" . [:pick $val $j ($j + 1)]) }
                        :set j ($j + 1)
                    }
                }
            }
        }
    }
    :return ""
}

:do {
    :local f [/file find name=$stateFile]

    :if ([:len $f] = 0) do={
        :log info ($tag . "SAFE no saved state file - cold start")
        :set mbc3RestoreDone true
    } else={
        :local data [/file get $f contents]
        :local dlen [:len $data]

        :if ($dlen < $minLen) do={
            :log warning ($tag . "SAFE saved state too short - cold start len=" . $dlen)
            :set mbc3RestoreDone true
        } else={
            :if ($dlen > $maxLen) do={
                :log error ($tag . "DISRUPTIVE saved state too large - refused len=" . $dlen)
                :set mbc3RestoreDone true
            } else={
                :if ([:typeof [:find $data $markerStart]] != "num") do={
                    :log warning ($tag . "SAFE start marker missing - cold start")
                    :set mbc3RestoreDone true
                } else={
                    :if ([:typeof [:find $data $markerEnd]] != "num") do={
                        :log warning ($tag . "SAFE end marker missing - cold start")
                        :set mbc3RestoreDone true
                    } else={
                        :local why [$stateReason $data]
                        :if ($why != "") do={
                            :log warning ($tag . "SAFE state failed allow-list check (" . $why . ") - cold start")
                            :set mbc3RestoreDone true
                        } else={
                            :local cmds [:parse $data]
                            $cmds
                            :log info ($tag . "state restored from " . $stateFile . " len=" . $dlen)
                            :set mbc3RestoreDone true
                        }
                    }
                }
            }
        }
    }
} on-error={
    :log warning ($tag . "SAFE failed to restore from " . $stateFile . " - cold start")
    :set mbc3RestoreDone true
}
